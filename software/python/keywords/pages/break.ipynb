      "source": [
        "# break\n",
        "\n",
        "`break` exits the nearest enclosing `for` or `while` loop, skipping its `else` clause.\n",
        "\n"
      ]
    },
    {
      "cell_type": "code",
      "id": "dd1fb0ca63858c22",
      "metadata": {
      },
      "source": [
        "for number in range(10):\n",
        "    if number == 3:\n",
        "        break\n"
