      "source": [
        "# for\n",
        "\n",
        "`for` iterates over an iterable, assigning each item to a target. It is also used in comprehensions.\n",
        "\n"
      ]
    },
    {
      "cell_type": "code",
      "id": "46d8a28c9f4dc797",
      "metadata": {
      },
      "source": [
        "for item in ['a', 'b']:\n",
