      "source": [
        "# EOFError\n",
        "\n",
        "Raised by [`input()`](../../built_in_functions/pages/input.md) when it encounters end-of-file without reading data.\n",
        "\n"
      ]
    },
    {
      "cell_type": "code",
      "id": "4e7b71e672461f72",
      "metadata": {
      },
      "source": [
        "try:\n",
        "    line = input('> ')\n",
        "except EOFError:\n",
        "    line = None\n"
