      "source": [
        "# `__pos__`\n",
        "\n",
        "`__pos__(self)` implements unary plus for `+x`.\n",
        "\n"
      ]
    },
    {
      "cell_type": "code",
      "id": "007e63952a2e66d5",
      "metadata": {
      },
      "source": [
        "class Value:\n",
        "    def __pos__(self): return 42\n",
        "\n",
        "x = Value()\n",
        "assert +x == 42\n"
      ],
      "execution_count": null,
      "outputs": [

      ]
    },
    {
