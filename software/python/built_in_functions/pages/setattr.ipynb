      "source": [
        "# setattr\n",
        "\n",
        "Assign a value to a named attribute.\n",
        "\n",
        "**Signature:** `setattr(object, name, value, /)`\n",
        "\n"
      ]
    },
    {
      "cell_type": "code",
      "id": "f351e820ad12e44b",
      "metadata": {
      },
      "source": [
        "class C: pass\n",
        "x = C()\n",
        "setattr(x, 'a', 1)\n",
        "x.a  # 1\n"
