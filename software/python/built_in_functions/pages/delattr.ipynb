        "# delattr\n",
        "\n",
        "Delete a named attribute from an object.\n",
        "\n",
        "**Signature:** `delattr(object, name, /)`\n",
        "\n"
      ]
    },
    {
      "cell_type": "code",
      "id": "2cf4f4e68035a0db",
      "metadata": {
      },
      "source": [
        "class C: pass\n",
        "x = C()\n",
        "x.a = 1\n",
        "delattr(x, 'a')\n"
