      "source": [
        "# global\n",
        "\n",
        "`global` declares that names assigned in the current code block refer to the module's global namespace.\n",
        "\n"
      ]
    },
    {
      "cell_type": "code",
      "id": "79a5c1347a9fd1c2",
      "metadata": {
      },
      "source": [
        "count = 0\n",
        "def increment():\n",
        "    global count\n",
        "    count += 1\n"
