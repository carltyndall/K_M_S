      "source": [
        "# filter\n",
        "\n",
        "Return an iterator of items for which the function is true; `None` tests truthiness.\n",
        "\n",
        "**Signature:** `filter(function, iterable, /)`\n",
        "\n"
      ]
    },
    {
      "cell_type": "code",
      "id": "d8bd729c6925be34",
      "metadata": {
      },
      "source": [
        "list(filter(None, [0, 1, 2]))  # [1, 2]\n"
