      "source": [
        "# `__neg__`\n",
        "\n",
        "`__neg__(self)` implements negation for `-x`.\n",
        "\n"
      ]
    },
    {
      "cell_type": "code",
      "id": "ca33ba0c11d20511",
      "metadata": {
      },
      "source": [
        "class Value:\n",
        "    def __neg__(self): return 42\n",
        "\n",
        "x = Value()\n",
        "assert -x == 42\n"
      ],
      "execution_count": null,
      "outputs": [

      ]
    },
    {
