      "source": [
        "# return\n",
        "\n",
        "`return` exits a function and supplies its result. Without an expression, it returns `None`.\n",
        "\n"
      ]
    },
    {
      "cell_type": "code",
      "id": "a6fd6213e7a63359",
      "metadata": {
      },
      "source": [
        "def square(number):\n",
        "    return number * number\n",
        "\n",
        "square(4)  # 16\n"
      ],
      "execution_count": null,
      "outputs": [

